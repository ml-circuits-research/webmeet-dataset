  {
    "id": "effect-788ca1b3-9117-5007-9111-6c9154fe7d3a",
    "sessionId": "b6e04fad-5ad6-a68d-a9a4-f7c44605cea2",
    "turnId": "turn-7b80f7c1e80ca6211089f92ed8b4eb00",
    "inputEntryId": "user-turn-7b80f7c1e80ca6211089f92ed8b4eb00-1",
